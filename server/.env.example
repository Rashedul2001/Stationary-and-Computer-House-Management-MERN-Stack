PORT=5000
NODE_ENV=development
MONGODB_NAME=PlaceYourDbName
MONGODB_URI=PlaceYourMongoDbUri
CLIENT_URL=http://localhost:5173

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-strong-32-char-random-secret-key
BETTER_AUTH_URL=http://localhost:5000

# Initial Seed Accounts
ADMIN_NAME=adminName
ADMIN_EMAIL=adminEmail
ADMIN_PASSWORD=adminPassword

ASSISTANT_NAME=assistantName
ASSISTANT_EMAIL=assistantEmail
ASSISTANT_PASSWORD=assistantPassword

# Cloudinary (Add your credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email for Forgot Password (Add your credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=WhatWouldBeYourIdentity
